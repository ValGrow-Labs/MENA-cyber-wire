# ==============================================================================
# MENA Cyber Wire - Environment Example (.env.example)
# Duplicate this file to .env.local to configure your local development environment
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site Branding & Metadata
NEXT_PUBLIC_SITE_NAME="MENA Cyber Wire"
NEXT_PUBLIC_SITE_TAGLINE="Regional Cyber Intelligence. Real-time Awareness."

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# In your Supabase Dashboard: Project Settings -> API
# 1. Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public 'anon' Key (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Secret 'service_role' Key (Server-side admin only - never share or expose)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Threat Intelligence & Vulnerability API Settings (Optional)
# ------------------------------------------------------------------------------
# NVD (National Vulnerability Database) API Key:
# Request a free API key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
